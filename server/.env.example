# ============================================================
#  Copy this file to  server/.env  and fill in the real values.
#
#  .env is in .gitignore, so it never goes to GitHub.
#  NEVER put any of these in the app/js folder — that folder
#  is sent to the browser and anyone can read it.
# ============================================================

# ---- Which gateway ----------------------------------------
# uddoktapay  (default) your own instance
# piprapay    self-hosted alternative
# sslcommerz  the hosted gateway
PAYMENT_PROVIDER=uddoktapay

# ---- Your gateway instance --------------------------------
# Your own address. The dashboard shows it with /api on the
# end; either form works.
#   live     https://hello-students.paymently.io
#   testing  https://sandbox.uddoktapay.com
PAYMENT_BASE_URL=https://hello-students.paymently.io

# Dashboard > API key. Never put this in app/js — that folder
# is sent to the browser and anyone can read it.
PAYMENT_API_KEY=paste_your_api_key_here

# ---- SSLCommerz (only if PAYMENT_PROVIDER=sslcommerz) ------
# Get these free at https://developer.sslcommerz.com/
STORE_ID=yourstore0live
STORE_PASSWORD=yourstorepassword
IS_LIVE=false

# ---- Supabase ---------------------------------------------
# Project Settings > API
SUPABASE_URL=https://fdbhieucrccvnzykpnpg.supabase.co

# Project Settings > API > service_role  (SECRET!)
# This key ignores all security rules, which is why only the
# server may hold it. It is the only thing allowed to mark a
# payment as paid.
SUPABASE_SERVICE_ROLE_KEY=paste_the_service_role_key_here

# ---- Email ------------------------------------------------
# Every notification the app writes is also sent as an email.
# Leave these blank and email is simply switched off — the
# bell inside the app keeps working either way.
#
# For Gmail: turn on 2-step verification, then make an
# "App password" at https://myaccount.google.com/apppasswords
# and paste that here. Your normal Gmail password will not work.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your_16_character_app_password
MAIL_FROM=HelloStudents <you@gmail.com>

# ---- Where the website is ---------------------------------
# The student is sent back here after paying, and it is the
# address the email buttons point at.
SITE_URL=http://localhost:5500

# ---- This server ------------------------------------------
PORT=5500
