# ============================================================
#  Copy this file to  server/.env  and fill in the real values.
#
#  .env is in .gitignore, so it never goes to GitHub.
#  NEVER put any of these in the app/js folder — that folder
#  is sent to the browser and anyone can read it.
# ============================================================

# ---- SSLCommerz -------------------------------------------
# Get these free at https://developer.sslcommerz.com/
STORE_ID=yourstore0live
STORE_PASSWORD=yourstorepassword
IS_LIVE=false

# ---- Supabase ---------------------------------------------
# Project Settings > API
SUPABASE_URL=https://fdbhieucrccvnzykpnpg.supabase.co

# Project Settings > API > service_role  (SECRET!)
# This key ignores all security rules, which is why only the
# server may hold it. It is the only thing allowed to mark a
# payment as paid.
SUPABASE_SERVICE_ROLE_KEY=paste_the_service_role_key_here

# ---- Where the website is ---------------------------------
# The student is sent back here after paying.
SITE_URL=http://localhost:5500

# ---- This server ------------------------------------------
PORT=5500
