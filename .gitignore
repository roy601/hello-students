# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editors
.vscode/
.idea/

# Node
node_modules/

# Secrets — never commit these
.env
.env.local
# any .env.something (backups, .env.production), but keep the
# example, which holds placeholders only
.env.*
!.env.example

# Archives
*.zip

# Kept off GitHub on purpose
# These are already ignored here, but a file git ALREADY tracks
# keeps being committed regardless — see the git rm --cached
# step. Ignoring only stops NEW files being picked up.
app/db/
Requirements/
